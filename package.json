{
  "name": "etsy-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -n pages,worker -c blue,green \"npm:dev:pages\" \"npm:dev:worker\"",
    "dev:pages": "wrangler pages dev dist --compatibility-date=2026-05-03",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "build:worker": "tsc -p workers/etsy-sync/tsconfig.json",
    "dev:worker": "wrangler dev --config workers/etsy-sync/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config workers/etsy-sync/wrangler.jsonc",
    "preview": "vite preview",
    "test": "vitest run",
    "fixture:reconciliation": "node scripts/extract-reconciliation-fixture.mjs",
    "publish:oss": "bash scripts/publish-oss.sh"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "echarts": "^5.6.0",
    "lucide-react": "^1.21.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
